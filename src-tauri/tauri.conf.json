{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pidan",
  "version": "0.1.3",
  "identifier": "ai.pidan.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pet",
        "title": "皮蛋",
        "width": 170,
        "height": 400,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "url": "index.html"
      },
      {
        "label": "panel",
        "title": "皮蛋面板",
        "width": 320,
        "height": 240,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "url": "panel.html"
      },
      {
        "label": "config",
        "title": "皮蛋配置",
        "width": 360,
        "height": 260,
        "decorations": true,
        "resizable": false,
        "visible": false,
        "url": "config.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Pidan",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../hooks/pidan-hook.ps1": "hooks/pidan-hook.ps1",
      "../hooks/pidan-hook.sh": "hooks/pidan-hook.sh",
      "../installer/patch-claude-settings.ps1": "installer/patch-claude-settings.ps1"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "../installer/pidan-hooks.nsh"
      }
    }
  }
}
